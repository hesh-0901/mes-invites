rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Profil personnel : un utilisateur ne peut accéder qu'à son propre document.
    // La création est autorisée avant la vérification de l'e-mail, car le profil
    // est enregistré pendant le processus d'inscription.
    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null
        && request.auth.uid == userId
        && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Données partagées de l'événement : accès réservé aux comptes connectés
    // dont l'adresse e-mail a été vérifiée.
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    match /tables/{documentId} {
      allow read, create, update, delete: if isVerifiedUser();
    }
    match /guests/{documentId} {
      allow read, create, update, delete: if isVerifiedUser();
    }
    match /checkins/{documentId} {
      allow read, create, update, delete: if isVerifiedUser();
    }
    match /eventSettings/{documentId} {
      allow read, create, update, delete: if isVerifiedUser();
    }

    // Refus par défaut pour toute autre collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}