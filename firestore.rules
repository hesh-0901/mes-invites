rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque utilisateur peut accéder uniquement à son propre profil.
    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;
      allow read, update: if request.auth != null
        && request.auth.uid == userId
        && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Les données de l'événement restent fermées jusqu'à la mise en place
    // de règles multi-utilisateur et d'un modèle de propriété des documents.
    match /tables/{documentId} { allow read, write: if false; }
    match /guests/{documentId} { allow read, write: if false; }
    match /checkins/{documentId} { allow read, write: if false; }
    match /eventSettings/{documentId} { allow read, write: if false; }

    // Refus par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}