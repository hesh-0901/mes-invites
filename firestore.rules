rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return hasProfile() && userProfile().super_admin == true;
    }

    function isProjectAdmin(projectId) {
      return signedIn() && hasProfile()
        && userProfile().role == 'admin'
        && userProfile().status == 'approved'
        && userProfile().projectId == projectId;
    }

    function activeProject(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.status == 'active';
    }

    match /projects/{projectId} {
      allow create: if isSuperAdmin()
        && request.resource.data.id == projectId
        && request.resource.data.ownerUid is string
        && request.resource.data.status == 'active';
      allow read: if request.auth != null && resource.data.status == 'active' || (signedIn() && (
        isSuperAdmin()
        || (resource.data.ownerUid == request.auth.uid)
        || isProjectAdmin(projectId)
        || (hasProfile() && userProfile().role == 'collaborator'
          && userProfile().status == 'approved'
          && userProfile().projectId == projectId)
        || (hasProfile() && userProfile().role == 'collaborator'
          && userProfile().status == 'pending'
          && userProfile().projectId == projectId)
      ));
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.super_admin == false
        && request.resource.data.status == 'pending'
        && (
          (request.resource.data.role == 'admin' && request.resource.data.projectId == null)
          || (request.resource.data.role == 'collaborator'
            && request.resource.data.projectId is string
            && activeProject(request.resource.data.projectId))
        );

      allow read: if request.auth != null && request.auth.uid == userId || (signedIn() && (
        request.auth.uid == userId
        || isSuperAdmin()
        || (resource.data.projectId is string && isProjectAdmin(resource.data.projectId))
      ));

      allow update: if signedIn() && (
        (request.auth.uid == userId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.super_admin == resource.data.super_admin
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.projectId == resource.data.projectId)
        || isSuperAdmin()
        || (resource.data.role == 'collaborator'
          && resource.data.status == 'pending'
          && isProjectAdmin(resource.data.projectId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.projectId == resource.data.projectId
          && request.resource.data.super_admin == false
          && request.resource.data.status in ['approved', 'rejected'])
      );
      allow delete: if isSuperAdmin();
    }

    function isApprovedProjectMember(projectId) {
      return hasProfile()
        && userProfile().status == 'approved'
        && userProfile().projectId == projectId
        && (userProfile().role == 'collaborator' || (signedIn() && userProfile().role == 'admin'));
    }

    match /projects/{projectId}/{collectionName}/{documentId} {
      allow read: if request.auth != null && (isSuperAdmin() || isApprovedProjectMember(projectId));
      allow create, update, delete: if request.auth != null && (isSuperAdmin() || isApprovedProjectMember(projectId));
    }

    // Legacy unscoped collections remain blocked until project-scoped migration.
    match /tables/{documentId} { allow read, write: if false; }
    match /guests/{documentId} { allow read, write: if false; }
    match /checkins/{documentId} { allow read, write: if false; }
    match /eventSettings/{documentId} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}