rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.super_admin == true;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.super_admin == false
        && request.resource.data.role == 'admin'
        && request.resource.data.status == 'pending'
        && request.resource.data.projectId == null;

      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());

      // A user may update personal fields, but cannot promote their own role,
      // approve their account, assign a project, or grant super-admin rights.
      allow update: if signedIn() && (
        (request.auth.uid == userId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.super_admin == resource.data.super_admin
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.projectId == resource.data.projectId)
        || isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // Legacy unscoped collections remain blocked until project-scoped migration
    // is deployed. This prevents accidental cross-project data exposure.
    match /tables/{documentId} { allow read, write: if false; }
    match /guests/{documentId} { allow read, write: if false; }
    match /checkins/{documentId} { allow read, write: if false; }
    match /eventSettings/{documentId} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}