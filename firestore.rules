rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return signedIn() && hasProfile() && userProfile().super_admin == true;
    }

    function isProjectAdmin(projectId) {
      return signedIn() && hasProfile()
        && userProfile().role == 'admin'
        && userProfile().status == 'approved'
        && userProfile().projectId == projectId
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/projects/$(projectId)).data.status == 'active';
    }

    function activeProject(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.status == 'active';
    }

    function isApprovedProjectMember(projectId) {
      // Les comptes collaborateurs utilisent un identifiant de connexion interne
      // qui peut ne pas être marqué comme e-mail vérifié par Firebase Auth.
      // Le profil approuvé et lié au projet reste le contrôle d'accès principal.
      return request.auth != null && hasProfile()
        && userProfile().status == 'approved'
        && userProfile().projectId == projectId
        && activeProject(projectId)
        && (
          userProfile().role == 'collaborator'
          || (
            userProfile().role == 'admin'
            && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid
          )
        );
    }

    function collaboratorHasMenu(menuId) {
      return userProfile().role == 'collaborator'
        && (
          (userProfile().permissions is list && userProfile().permissions.hasAny([menuId]))
          || (!(userProfile().permissions is list)
            && menuId in ['dashboard', 'tables', 'guests', 'invitations', 'scanner', 'history'])
        );
    }

    function canReadProjectCollection(projectId, collectionName) {
      return isSuperAdmin()
        || isProjectAdmin(projectId)
        || (
          isApprovedProjectMember(projectId)
          && (
            (collectionName == 'tables' && collaboratorHasMenu('tables'))
            || (collectionName == 'guests'
              && (collaboratorHasMenu('guests') || collaboratorHasMenu('invitations') || collaboratorHasMenu('scanner')))
            || (collectionName == 'checkins'
              && (collaboratorHasMenu('scanner') || collaboratorHasMenu('history')))
            // Les paramètres communs sont lisibles par tout collaborateur approuvé,
            // notamment pour prévisualiser et télécharger une invitation.
            || collectionName == 'eventSettings'
            || (collectionName == 'templates' && collaboratorHasMenu('templates'))
          )
        );
    }

    function canWriteProjectCollection(projectId, collectionName) {
      return isSuperAdmin()
        || isProjectAdmin(projectId)
        || (
          isApprovedProjectMember(projectId)
          && (
            (collectionName == 'tables' && collaboratorHasMenu('tables'))
            || (collectionName == 'guests'
              && (collaboratorHasMenu('guests') || collaboratorHasMenu('invitations') || collaboratorHasMenu('scanner')))
            || (collectionName == 'checkins'
              && (collaboratorHasMenu('scanner') || collaboratorHasMenu('history')))
            || (collectionName == 'eventSettings'
              && (collaboratorHasMenu('settings') || collaboratorHasMenu('templates')))
            || (collectionName == 'templates' && collaboratorHasMenu('templates'))
          )
        );
    }

    match /projects/{projectId} {
      allow create: if isSuperAdmin()
        && request.resource.data.id == projectId
        && request.resource.data.ownerUid is string
        && request.resource.data.status == 'active';

      // Active project metadata must be readable to allow collaborators to
      // validate a project code before their profile is created.
      allow read: if (request.auth != null && resource.data.status == 'active')
        || (signedIn() && (
          isSuperAdmin()
          || resource.data.ownerUid == request.auth.uid
          || isProjectAdmin(projectId)
          || (hasProfile()
            && userProfile().role == 'collaborator'
            && userProfile().projectId == projectId)
        ));

      allow update, delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.super_admin == false
        && request.resource.data.status == 'pending'
        && (
          (
            request.resource.data.role == 'admin'
            && request.auth.token.firebase.sign_in_provider != 'anonymous'
            && request.auth.token.email_verified == true
            && request.resource.data.projectId == null
            && request.resource.data.keys().hasOnly([
              'uid', 'firstName', 'lastName', 'whatsapp', 'email',
              'role', 'status', 'super_admin', 'projectId', 'createdAt'
            ])
          )
          ||
          (
            request.resource.data.role == 'collaborator'
            && request.resource.data.projectId is string
            && activeProject(request.resource.data.projectId)
            && request.resource.data.keys().hasOnly([
              'uid', 'firstName', 'lastName', 'email', 'whatsapp',
              'role', 'status', 'super_admin', 'projectId', 'createdAt'
            ])
          )
        );

      allow read: if (request.auth != null && request.auth.uid == userId)
        || (signedIn() && (
          isSuperAdmin()
          || (resource.data.projectId is string && isProjectAdmin(resource.data.projectId))
        ));

      allow update: if signedIn() && (
        (request.auth.uid == userId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.super_admin == resource.data.super_admin
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.projectId == resource.data.projectId)
        || isSuperAdmin()
        || (resource.data.role == 'collaborator'
          && resource.data.status == 'pending'
          && resource.data.projectId is string
          && isProjectAdmin(resource.data.projectId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'reviewedAt', 'reviewedBy'])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.projectId == resource.data.projectId
          && request.resource.data.super_admin == false
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedBy == request.auth.uid)
        || (resource.data.role == 'collaborator'
          && resource.data.status == 'approved'
          && isProjectAdmin(resource.data.projectId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'permissions', 'permissionsUpdatedAt', 'permissionsUpdatedBy',
              'displayName', 'whatsapp', 'profileUpdatedAt', 'profileUpdatedBy',
              'status', 'removedAt', 'removedBy'
            ])
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['permissions', 'permissionsUpdatedAt', 'permissionsUpdatedBy'])
              && request.resource.data.permissions is list
              && request.resource.data.permissions.size() <= 8
              && request.resource.data.permissions.toSet().hasOnly([
                'dashboard', 'tables', 'guests', 'invitations',
                'scanner', 'history', 'templates', 'settings'
              ])
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['displayName', 'whatsapp', 'profileUpdatedAt', 'profileUpdatedBy'])
              && request.resource.data.displayName is string
              && request.resource.data.displayName.size() > 0
              && request.resource.data.profileUpdatedBy == request.auth.uid
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'removedAt', 'removedBy'])
              && request.resource.data.status == 'rejected'
              && request.resource.data.removedBy == request.auth.uid
            )
          ))
      );

      allow delete: if isSuperAdmin()
        || (
          signedIn()
          && resource.data.role == 'collaborator'
          && resource.data.projectId is string
          && isProjectAdmin(resource.data.projectId)
        );
    }

    function validAcceptedCheckinCreate(projectId, checkinId) {
      return request.resource.data.result == 'accepted'
        && request.resource.data.guestId is string
        && request.resource.data.guestId.size() > 0
        && request.resource.data.timestamp is string
        && request.resource.data.guestName is string
        && request.resource.data.tableName is string
        && request.resource.data.operator is string
        && request.resource.data.operatorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/projects/$(projectId)/guests/$(request.resource.data.guestId)).data.checkinStatus == 'checked-in'
        && getAfter(/databases/$(database)/documents/projects/$(projectId)/guests/$(request.resource.data.guestId)).data.lastCheckinId == checkinId
        && getAfter(/databases/$(database)/documents/projects/$(projectId)/guests/$(request.resource.data.guestId)).data.checkedInAt == request.resource.data.timestamp;
    }

    function validGuestCheckinReset(projectId) {
      return signedIn()
        && resource.data.checkinStatus == 'checked-in'
        && resource.data.lastCheckinId is string
        && request.resource.data.checkinStatus == 'not-checked-in'
        && !('checkedInAt' in request.resource.data)
        && !('lastCheckinId' in request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['checkinStatus', 'checkedInAt', 'lastCheckinId'])
        && exists(/databases/$(database)/documents/projects/$(projectId)/checkins/$(resource.data.lastCheckinId))
        && get(/databases/$(database)/documents/projects/$(projectId)/checkins/$(resource.data.lastCheckinId)).data.operatorUid == request.auth.uid;
    }

    function validGuestCheckinUpdate(projectId, guestId) {
      return resource.data.checkinStatus != 'checked-in'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['checkinStatus', 'checkedInAt', 'lastCheckinId'])
        && request.resource.data.checkinStatus == 'checked-in'
        && request.resource.data.checkedInAt is string
        && request.resource.data.lastCheckinId is string
        && getAfter(/databases/$(database)/documents/projects/$(projectId)/checkins/$(request.resource.data.lastCheckinId)).data.guestId == guestId
        && getAfter(/databases/$(database)/documents/projects/$(projectId)/checkins/$(request.resource.data.lastCheckinId)).data.result == 'accepted'
        && getAfter(/databases/$(database)/documents/projects/$(projectId)/checkins/$(request.resource.data.lastCheckinId)).data.timestamp == request.resource.data.checkedInAt;
    }

    match /projects/{projectId}/{collectionName}/{documentId} {
      allow read: if canReadProjectCollection(projectId, collectionName);
      allow create: if canWriteProjectCollection(projectId, collectionName)
        && (collectionName != 'guests' || userProfile().role != 'collaborator' || collaboratorHasMenu('guests') || collaboratorHasMenu('invitations'))
        && (collectionName != 'guests' || request.resource.data.checkinStatus != 'checked-in')
        && (collectionName != 'checkins'
          || request.resource.data.result != 'accepted'
          || validAcceptedCheckinCreate(projectId, documentId));
      allow update: if canWriteProjectCollection(projectId, collectionName)
        && (collectionName != 'guests' || userProfile().role != 'collaborator' || collaboratorHasMenu('guests') || collaboratorHasMenu('invitations')
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkinStatus', 'checkedInAt', 'lastCheckinId']))
        && (collectionName != 'guests'
          || !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['checkinStatus', 'checkedInAt', 'lastCheckinId'])
          || validGuestCheckinUpdate(projectId, documentId)
          || validGuestCheckinReset(projectId));
      allow delete: if (
          collectionName == 'checkins'
          && (
            isSuperAdmin()
            || isProjectAdmin(projectId)
            || (signedIn() && resource.data.operatorUid is string
              && resource.data.operatorUid == request.auth.uid)
          )
        )
        || (
          collectionName != 'checkins'
          && canWriteProjectCollection(projectId, collectionName)
          && (collectionName != 'guests' || userProfile().role != 'collaborator' || collaboratorHasMenu('guests') || collaboratorHasMenu('invitations'))
        );
    }

    // Legacy unscoped collections remain blocked until project-scoped migration.
    match /tables/{documentId} { allow read, write: if false; }
    match /guests/{documentId} { allow read, write: if false; }
    match /checkins/{documentId} { allow read, write: if false; }
    match /eventSettings/{documentId} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}